# Endereço do site atendido pelo Caddy:
# - Em produção, informe o domínio real (ex.: salgados.exemplo.com.br) para HTTPS automático.
# - Para teste local sem HTTPS, use :80.
SITE_ADDRESS=salgados.exemplo.com.br

# Portas publicadas no host pelo container web (padrão: 80 e 443)
HTTP_PORT=80
HTTPS_PORT=443

# Dados do banco PostgreSQL de produção
POSTGRES_DB=salgados
POSTGRES_USER=salgados
# Gere uma senha forte com: openssl rand -base64 48
POSTGRES_PASSWORD=TROQUE_POR_VALOR_GERADO_COM_OPENSSL_RAND_BASE64_48

# Segredo de assinatura do token JWT (mínimo de 32 bytes)
# Gere um segredo forte com: openssl rand -base64 48
JWT_SECRET=TROQUE_POR_VALOR_GERADO_COM_OPENSSL_RAND_BASE64_48

# Usuário administrador inicial (criado automaticamente se a tabela users estiver vazia)
APP_ADMIN_NAME=Ulerich Salgados
APP_ADMIN_EMAIL=admin@exemplo.com.br
APP_ADMIN_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
